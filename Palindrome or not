#include <stdio.h>
int main() 
{
    int num,rem,reverse = 0,temp;
    printf("enter any number :\n");
    scanf("%d",&num);
    temp = num;
    while(num != 0)
    {
        rem = num % 10;
        reverse = reverse * 10 + rem;
        num = num/10;
    }
    if(reverse == temp)
    {
        printf("The given number %d is palindrome.\n",reverse);
    }
    else
    {
        printf("%d is not a palindrome.\n",reverse);
    }
   return 0;
   
}
