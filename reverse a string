#include<stdio.h>
void main()
{
  char str[100],temp;
  int i,len = 0;
  printf("Enter any string :\n");
  scanf("%s",str);
  for(i = 0;str[i] != '\0';i++)
    {
      len++;
    }
  for(i = 0;i = len/2;i++)
    {
      temp = str[i];
      str[i] = str[len - i - 1];
      str[len - i - 1] = temp;
    }
  printf("The reversed string is %s.\n",str);
  }
