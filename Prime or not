#include <stdio.h>
int main() 
{
    int num,flag = 1,i;
    printf("enter any number :\n");
    scanf("%d",&num);
    if(num<2)
    {
        printf("%d is not a prime number.\n",num);
        return 1;
    }
    
    for(i = 2;i<num/2;i++)
    {
        if(num % i == 0)
        {
            flag = 0;
            printf("%d is not a prime number.\n",num);
            return 1;
        }
    }
    if(flag)
    {
        printf("%d is a prime number.\n",num);
    }
    return 0;
}
